// Runtime placement and stack ABI, not architectural SRAM capacity.
IPU_CONSTANT(EXCHANGE_WINDOW_BASE, u32, 0x50000)
IPU_CONSTANT(EXCHANGE_WINDOW_BYTES, u32, 0x8000)
IPU_CONSTANT(HOST_PACKET_ADDRESS, u32, EXCHANGE_WINDOW_BASE)
IPU_CONSTANT(HOST_CLOSE_ADDRESS, u32, EXCHANGE_WINDOW_BASE + 0x160)
IPU_CONSTANT(HOST_STAGING_ADDRESS, u32, EXCHANGE_WINDOW_BASE + 0x180)
IPU_CONSTANT(WORKER_STACK_HEADROOM, u32, 0xe0)
IPU_CONSTANT(WORKER_SYNC_STRIDE, u32, 0x100)
IPU_CONSTANT(HOST_RUN_DESCRIPTOR_WORDS, usize, 3)
IPU_CONSTANT(HOST_RUN_DESCRIPTOR_BYTES, usize, HOST_RUN_DESCRIPTOR_WORDS * 4)
IPU_CONSTANT(RUNTIME_STATE_BASE, u32, EXCHANGE_WINDOW_BASE + EXCHANGE_WINDOW_BYTES)
